{
  "name": "resonate",
  "version": "1.6.0",
  "private": true,
  "description": "Resonate — a podcast downloader and player for the Linux desktop.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "dist:update-info": "node scripts/appimage-update.mjs release/Resonate-$npm_package_version.AppImage",
    "test": "vitest run && npm run test:db",
    "test:coverage": "vitest run --coverage",
    "test:db": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "bench": "vitest bench --run",
    "test:perf": "PERF=1 vitest run test/perf",
    "icons": "node scripts/icons.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.1.0",
    "@phosphor-icons/web": "^2.1.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^43.8.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "zustand": "^4.5.5"
  },
  "main": "dist-electron/main.cjs",
  "author": "sekhnat <221756436+sekhnat@users.noreply.github.com>",
  "homepage": "https://github.com/sekhnat/ResonatePod",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekhnat/ResonatePod.git"
  },
  "bugs": {
    "url": "https://github.com/sekhnat/ResonatePod/issues"
  },
  "build": {
    "appId": "io.github.sekhnat.resonate",
    "productName": "Resonate",
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/build/{Release/obj,Release/.deps,deps}/**",
      "!node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Audio;Player",
      "icon": "assets/icon-512.png",
      "synopsis": "Podcast downloader and player",
      "desktop": {
        "entry": {
          "Name": "Resonate",
          "Comment": "Download and listen to podcasts",
          "Keywords": "podcast;rss;audio;"
        }
      }
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libsecret-1-0"
      ]
    }
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "better-sqlite3": true
  }
}
